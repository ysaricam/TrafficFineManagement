@model VehicleListViewModel
@{
    ViewData["Title"] = "Araçlar";
    var vehicleUserLabelsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Users.ToDictionary(
            user => user.Id.ToString(),
            user => $"{user.Name} {user.Surname} (@{user.Username})"));
}

<section class="hero">
    <div>
        <p class="eyebrow">Filo görünümü</p>
        <h1>Araçlar</h1>
        <p class="hero-copy">
            Kayıtlı araçların uygunluk durumunu ve temel bilgilerini tek ekrandan izleyin.
        </p>
    </div>
    <div class="live-indicator">
        <span aria-hidden="true"></span>
        Dapper read model
    </div>
</section>

@if (TempData["Success"] is string successMessage)
{
    <div class="flash flash-success" role="status">
        <span aria-hidden="true">✓</span>
        @successMessage
    </div>
}

@if (TempData["Error"] is string errorMessage)
{
    <div class="flash flash-error" role="alert">
        <span aria-hidden="true">!</span>
        @errorMessage
    </div>
}

<section class="metrics" aria-label="Araç özeti">
    <article class="metric-card metric-total">
        <span class="metric-label">Toplam araç</span>
        <strong>@Model.TotalCount</strong>
        <small>Filo envanteri</small>
    </article>
    <article class="metric-card metric-available">
        <span class="metric-label">Müsait</span>
        <strong>@Model.AvailableCount</strong>
        <small>Atama bekliyor</small>
    </article>
    <article class="metric-card metric-active">
        <span class="metric-label">Kullanımda</span>
        <strong>@Model.InUseCount</strong>
        <small>Aktif kullanıcı bağlı</small>
    </article>
</section>

<section class="vehicle-panel">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">Güncel envanter</p>
            <h2>Araç listesi</h2>
        </div>
        <div class="panel-actions">
            <span class="record-count">@Model.TotalCount kayıt</span>
            @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
            {
                <button class="button button-primary button-small"
                        type="button"
                        data-dialog-open="create-vehicle-dialog">
                    + Yeni araç
                </button>
            }
        </div>
    </div>

    @if (Model.Vehicles.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">◇</span>
            <h3>Henüz araç bulunmuyor</h3>
            <p>API üzerinden ilk araç kaydı oluşturulduğunda burada görünecek.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Plaka</th>
                        <th>Araç</th>
                        <th>Durum</th>
                        <th class="action-column"><span class="sr-only">İşlem</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vehicle in Model.Vehicles)
                    {
                        <tr>
                            <td data-label="Plaka">
                                <span class="plate">@vehicle.Plaka</span>
                            </td>
                            <td data-label="Araç">
                                <strong class="vehicle-name">@vehicle.Brand @vehicle.Model</strong>
                                <span class="vehicle-id">Tür · @VehicleListViewModel.GetVehicleTypeLabel(vehicle.Type)</span>
                                <span class="vehicle-id">@vehicle.Id</span>
                            </td>
                            <td data-label="Durum">
                                <div class="status-stack">
                                    @if (vehicle.Status)
                                    {
                                        <span class="status status-active"><i></i>Kullanımda</span>
                                        @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                                        {
                                        <button class="status-command status-command-complete"
                                                type="button"
                                                data-dialog-open="complete-usage-dialog"
                                                data-vehicle-id="@vehicle.Id"
                                                data-user-id="@vehicle.ActiveUserId"
                                                data-vehicle-label="@vehicle.Plaka · @vehicle.Brand @vehicle.Model"
                                                data-user-label="@Model.GetUserLabel(vehicle.ActiveUserId)">
                                            Kullanımı tamamla
                                        </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="status status-available"><i></i>Müsait</span>
                                        @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                                        {
                                        <button class="status-command status-command-assign"
                                                type="button"
                                                data-dialog-open="assign-user-dialog"
                                                data-vehicle-id="@vehicle.Id"
                                                data-vehicle-label="@vehicle.Plaka · @vehicle.Brand @vehicle.Model">
                                            Kullanıcı ata
                                        </button>
                                        }
                                    }
                                </div>
                            </td>
                            <td class="action-column">
                                <button class="detail-link detail-button"
                                        type="button"
                                        data-vehicle-history
                                        data-vehicle-id="@vehicle.Id"
                                        data-vehicle-label="@vehicle.Plaka · @vehicle.Brand @vehicle.Model">
                                    Araç geçmişi <span aria-hidden="true">↗</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<dialog class="command-dialog" id="create-vehicle-dialog" aria-labelledby="create-vehicle-title">
    <div class="dialog-card">
        <button class="dialog-close" type="button" data-dialog-close aria-label="Pencereyi kapat">×</button>
        <p class="eyebrow">Vehicle command</p>
        <h2 id="create-vehicle-title">Yeni araç ekle</h2>
        <p class="dialog-copy">Araç bilgileri kaydedildiğinde liste ve özet kartları otomatik güncellenir.</p>

        <form asp-action="CreateVehicle" method="post" class="command-form">
            <label>
                <span>Plaka</span>
                <input name="Plaka" autocomplete="off" placeholder="34 TFM 2026" required />
            </label>
            <div class="field-row">
                <label>
                    <span>Marka</span>
                    <input name="Brand" autocomplete="organization" placeholder="Toyota" required />
                </label>
                <label>
                    <span>Model</span>
                    <input name="Model" autocomplete="off" placeholder="Corolla" required />
                </label>
            </div>
            <label>
                <span>Araç tipi</span>
                <select name="Type" required>
                    <option value="0">Binek</option>
                    <option value="1">Çekici</option>
                    <option value="2">Dorse</option>
                    <option value="3">Kiralık araç</option>
                </select>
            </label>
            <div class="dialog-actions">
                <button class="button button-secondary" type="button" data-dialog-close>Vazgeç</button>
                <button class="button button-primary" type="submit">Aracı oluştur</button>
            </div>
        </form>

    </div>
</dialog>

<dialog class="command-dialog" id="assign-user-dialog" aria-labelledby="assign-user-title">
    <div class="dialog-card">
        <button class="dialog-close" type="button" data-dialog-close aria-label="Pencereyi kapat">×</button>
        <p class="eyebrow">User ilişkisi</p>
        <h2 id="assign-user-title">Kullanıcı ata</h2>
        <p class="dialog-copy selected-vehicle-label" id="assign-vehicle-label"></p>

        <form asp-action="AssignUser" method="post" class="command-form">
            <input id="assign-vehicle-id" type="hidden" name="VehicleId" />
            <label>
                <span>Kullanıcı</span>
                <select name="UserId" required>
                    <option value="">Kullanıcı seçin</option>
                    @foreach (var user in Model.Drivers)
                    {
                        <option value="@user.Id">@user.Name @user.Surname (@user.Username)</option>
                    }
                </select>
            </label>
            <label>
                <span>Başlangıç zamanı</span>
                <input id="usage-start-time" name="StartTime" type="datetime-local" />
            </label>
            <input id="usage-timezone-offset" name="TimeZoneOffsetMinutes" type="hidden" />
            <div class="dialog-actions">
                <button class="button button-secondary" type="button" data-dialog-close>Vazgeç</button>
                <button class="button button-primary" type="submit" disabled="@(Model.Drivers.Count == 0)">
                    Kullanıcıyı ata
                </button>
            </div>
        </form>

        @if (User.IsInRole("Admin"))
        {
        <div class="dialog-divider"><span>veya</span></div>
        <form asp-action="CreateUser" method="post" class="inline-user-create">
            <input id="create-user-vehicle-id" type="hidden" name="VehicleId" />
            <input id="create-user-start-time" type="hidden" name="StartTime" />
            <input id="create-user-timezone-offset" type="hidden" name="TimeZoneOffsetMinutes" />
            <label>
                <span>İsim</span>
                <input name="Name" autocomplete="given-name" required maxlength="100" />
            </label>
            <label>
                <span>Soyisim</span>
                <input name="Surname" autocomplete="family-name" required maxlength="100" />
            </label>
            <label>
                <span>Kullanıcı adı</span>
                <input name="Username" autocomplete="username" required minlength="3" maxlength="50" />
            </label>
            <label>
                <span>Parola</span>
                <input name="Password" type="password" autocomplete="new-password" required minlength="8" maxlength="128" />
            </label>
            <button class="button button-secondary button-small" type="submit">+ Şoför oluştur ve ata</button>
        </form>
        }

    </div>
</dialog>

<dialog class="command-dialog" id="complete-usage-dialog" aria-labelledby="complete-usage-title">
    <div class="dialog-card dialog-card-compact">
        <button class="dialog-close" type="button" data-dialog-close aria-label="Pencereyi kapat">×</button>
        <p class="eyebrow">Aktif kullanım</p>
        <h2 id="complete-usage-title">Kullanımı tamamla</h2>
        <p class="dialog-copy selected-vehicle-label" id="complete-vehicle-label"></p>
        <div class="relationship-summary">
            <span>Aktif kullanıcı</span>
            <strong id="complete-user-label"></strong>
        </div>
        <p class="dialog-warning">Araç tekrar müsait duruma geçecek ve bitiş zamanı şimdi olarak kaydedilecek.</p>

        <form asp-action="CompleteUsage" method="post">
            <input id="complete-vehicle-id" type="hidden" name="vehicleId" />
            <input id="complete-user-id" type="hidden" name="userId" />
            <div class="dialog-actions">
                <button class="button button-secondary" type="button" data-dialog-close>Vazgeç</button>
                <button class="button button-danger" type="submit">Kullanımı tamamla</button>
            </div>
        </form>
    </div>
</dialog>

<dialog class="command-dialog history-dialog" id="vehicle-history-dialog" aria-labelledby="vehicle-history-title">
    <div class="dialog-card">
        <button class="dialog-close" type="button" data-dialog-close aria-label="Pencereyi kapat">×</button>
        <p class="eyebrow">Kullanım geçmişi</p>
        <h2 id="vehicle-history-title">Araç geçmişi</h2>
        <p class="dialog-copy selected-vehicle-label" id="vehicle-history-label"></p>
        <div id="vehicle-history-content" class="history-list" aria-live="polite"></div>
    </div>
</dialog>

<script>
    const vehicleUserLabels = @Html.Raw(vehicleUserLabelsJson);

    const usageStartTime = document.getElementById('usage-start-time');
    const usageTimezoneOffset = document.getElementById('usage-timezone-offset');
    if (usageStartTime && usageTimezoneOffset) {
        const now = new Date();
        const localNow = toLocalDateTimeValue(now);
        usageStartTime.value = localNow;
        usageStartTime.max = localNow;
        usageTimezoneOffset.value = now.getTimezoneOffset();
    }

    document.querySelectorAll('[data-dialog-open]').forEach(button => {
        button.addEventListener('click', () => {
            const dialog = document.getElementById(button.dataset.dialogOpen);

            if (dialog.id === 'assign-user-dialog') {
                document.getElementById('assign-vehicle-id').value = button.dataset.vehicleId;
                document.getElementById('create-user-vehicle-id').value = button.dataset.vehicleId;
                document.getElementById('assign-vehicle-label').textContent = button.dataset.vehicleLabel;
            }

            if (dialog.id === 'complete-usage-dialog') {
                document.getElementById('complete-vehicle-id').value = button.dataset.vehicleId;
                document.getElementById('complete-user-id').value = button.dataset.userId;
                document.getElementById('complete-vehicle-label').textContent = button.dataset.vehicleLabel;
                document.getElementById('complete-user-label').textContent = button.dataset.userLabel;
            }

            dialog.showModal();
        });
    });

    document.querySelectorAll('[data-vehicle-history]').forEach(button => {
        button.addEventListener('click', async () => {
            const dialog = document.getElementById('vehicle-history-dialog');
            const content = document.getElementById('vehicle-history-content');
            document.getElementById('vehicle-history-label').textContent = button.dataset.vehicleLabel;
            content.innerHTML = '<p class="history-loading">Araç geçmişi yükleniyor…</p>';
            dialog.showModal();

            try {
                const response = await fetch(`/api/vehicles/${button.dataset.vehicleId}`);
                if (!response.ok) throw new Error('Araç geçmişi alınamadı.');

                const vehicle = await response.json();
                const usages = [...(vehicle.users ?? [])].reverse();

                content.innerHTML = usages.length
                    ? usages.map(usage => {
                        const userLabel = vehicleUserLabels[usage.userId] ?? usage.userId;
                        const endLabel = usage.endTime
                            ? `Bitiş · ${formatDate(usage.endTime)}`
                            : 'Aktif kullanım';

                        return `
                            <article class="history-item">
                                <span class="history-dot"></span>
                                <div>
                                    <strong>${escapeHtml(userLabel)}</strong>
                                    <span>Başlangıç · ${formatDate(usage.startTime)}</span>
                                    <small>${endLabel}</small>
                                </div>
                            </article>`;
                    }).join('')
                    : '<p class="history-loading">Bu araç için henüz kullanım kaydı bulunmuyor.</p>';
            } catch (error) {
                content.innerHTML = `<p class="history-error">${escapeHtml(error.message)}</p>`;
            }
        });
    });

    document.querySelectorAll('[data-dialog-close]').forEach(button => {
        button.addEventListener('click', () => button.closest('dialog').close());
    });

    const createUserForm = document.querySelector('.inline-user-create');
    if (createUserForm) {
        createUserForm.addEventListener('submit', () => {
            document.getElementById('create-user-start-time').value = usageStartTime.value;
            document.getElementById('create-user-timezone-offset').value = usageTimezoneOffset.value;
        });
    }

    document.querySelectorAll('dialog').forEach(dialog => {
        dialog.addEventListener('click', event => {
            if (event.target === dialog) {
                dialog.close();
            }
        });
    });

    function formatDate(value) {
        return new Date(value).toLocaleString('tr-TR');
    }

    function escapeHtml(value) {
        const element = document.createElement('div');
        element.textContent = value;
        return element.innerHTML;
    }

    function toLocalDateTimeValue(date) {
        const localDate = new Date(date.getTime() - date.getTimezoneOffset() * 60_000);
        return localDate.toISOString().slice(0, 16);
    }
</script>
