{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug TrafficFineManagement API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/API/TrafficFineManagement.API/bin/Debug/net10.0/TrafficFineManagement.API.dll",
      "cwd": "${workspaceFolder}/src/API/TrafficFineManagement.API",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5090"
      }
    }
  ]
}
